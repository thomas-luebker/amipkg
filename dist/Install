.BRA {
.KET }
; ---------------------------------------------------------------------------
; amipkg - standalone setup for AmigaOS 3.x
;
; amipkg LIVES IN THIS DRAWER - wherever you unpacked or copied it (like
; MUI:). Nothing is copied anywhere else. This script just:
;   1. assigns AMIPKG: to this drawer (amipkg re-creates it itself on
;      every start - nothing is written to your Startup-Sequence)
;   2. creates the data drawers (cache / config / db)
;   3. seeds amipkg's own receipt so self-update works from day one
; The signed catalog (packages.json) already sits here, so amipkg works
; OFFLINE immediately.
;
;   Double-click the Install icon, or: CD into this drawer, Execute Install
; ---------------------------------------------------------------------------
FailAt 21

Echo "Setting up amipkg in this drawer ..."

; 1. This drawer IS the home: assign now (first amipkg run persists it).
Assign >NIL: AMIPKG: ""
Path >NIL: "" ADD

Protect >NIL: amipkg +e
Protect >NIL: amipkg-gui +e
Protect >NIL: amipkg-mui +e

; 2. Data drawers next to the binaries.
If Not Exists AMIPKG:cache
  MakeDir >NIL: AMIPKG:cache
EndIf
If Not Exists AMIPKG:config
  MakeDir >NIL: AMIPKG:config
EndIf
If Not Exists AMIPKG:db
  MakeDir >NIL: AMIPKG:db
EndIf
If Not Exists AMIPKG:db/files
  MakeDir >NIL: AMIPKG:db/files
EndIf
If Not Exists AMIPKG:db/scripts
  MakeDir >NIL: AMIPKG:db/scripts
EndIf

; 3. Seed amipkg's own receipt so `amipkg check` / `amipkg upgrade amipkg`
;    manage it from day one (self-update). Guarded against re-runs.
If Not Exists AMIPKG:db/installed.txt
  Echo NOLINE "" >AMIPKG:db/installed.txt
EndIf
Search >NIL: AMIPKG:db/installed.txt "amipkg|"
If Warn
  Echo "amipkg|0.4.2|1|0" >>AMIPKG:db/installed.txt
  Echo "AMIPKG:amipkg" >AMIPKG:db/files/amipkg.files
  Echo "AMIPKG:amipkg-gui" >>AMIPKG:db/files/amipkg.files
  Echo "AMIPKG:amipkg-gui.info" >>AMIPKG:db/files/amipkg.files
  Echo "AMIPKG:amipkg-mui" >>AMIPKG:db/files/amipkg.files
  Echo "AMIPKG:amipkg-mui.info" >>AMIPKG:db/files/amipkg.files
  Echo "AMIPKG:amipkg.guide" >>AMIPKG:db/files/amipkg.files
EndIf

; 4. First run: health check (the binaries set the assign up themselves
;    on every start - no system file is ever touched).
amipkg doctor

Echo "*N========================================================"
Echo "amipkg is set up IN THIS DRAWER (assign: AMIPKG:)."
Echo "  CLI : amipkg            (try:  amipkg avail )"
Echo "  GUI : amipkg-gui        (GadTools, no dependencies)"
Echo "        amipkg-mui        (MUI 3.8+ - the polished one)"
Echo "  Catalog: 100+ packages (bundled, signed, works offline)"
Echo "*NYou can move this drawer later: run Install here again."
Echo "*NBring your TCP/IP stack ONLINE, then to refresh + install:"
Echo "  amipkg update           (fetch the latest signed catalog)"
Echo "  amipkg avail <term>     (search)"
Echo "  amipkg install <id>     (download + verify + install)"
Echo "========================================================"
